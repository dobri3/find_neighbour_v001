# Dockerfile
# Мульти-стадийная сборка
FROM --platform=$BUILDPLATFORM ubuntu:22.04 as builder

# Установка зависимостей для сборки
RUN apt-get update && apt-get install -y \
    curl \
    unzip \
    git \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# Создаем non-root пользователя
RUN useradd -m flutter

USER flutter

# Установка Flutter
RUN git clone --branch stable --depth 1 https://github.com/flutter/flutter.git /home/flutter/flutter
ENV PATH="/home/flutter/flutter/bin:$PATH"

WORKDIR /home/flutter/app

# Кэширование зависимостей
COPY --chown=flutter:flutter pubspec.yaml pubspec.lock ./
RUN flutter pub get

# Копирование кода
COPY --chown=flutter:flutter . .

# Сборка с переменными окружения
ARG BASE_URL=http://localhost:8080/api/v1
ARG WS_BASE_URL=ws://localhost:8080/api/v1
ARG ORIGIN=http://localhost:8888

RUN flutter build web --release \
    --dart-define=BASE_URL=$BASE_URL \
    --dart-define=WS_BASE_URL=$WS_BASE_URL \
    --dart-define=ORIGIN=$ORIGIN

# Финальный образ с Nginx
FROM nginx:alpine

# Удаляем дефолтную конфигурацию Nginx
RUN rm -rf /etc/nginx/conf.d/default.conf

# Копируем кастомную конфигурацию Nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Копируем собранное приложение из builder стадии
COPY --from=builder /home/flutter/app/build/web /usr/share/nginx/html

# Создаем non-root пользователя и меняем владельца файлов
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

# Экспонируем порт 80
EXPOSE 80

# Запускаем Nginx
CMD ["nginx", "-g", "daemon off;"]
